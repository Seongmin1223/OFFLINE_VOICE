# Offline Voice Fix Assistant
# Copy this file to .env and adjust local paths.

# API
API_HOST=0.0.0.0
API_PORT=8000
STT_SERVER_URL=http://127.0.0.1:8081
LLM_SERVER_URL=http://127.0.0.1:8080

# STT: whisper.cpp server binary and child-voice quantized model.
WHISPER_BIN_PATH=C:/dev/whisper.cpp/Release/whisper-server.exe
WHISPER_MODEL_PATH=C:/dev/whisper.cpp/models/ggml-poby-stt-q8_0.bin
WHISPER_LANGUAGE=ko
WHISPER_THREADS=4

# LLM: llama.cpp server binary and GGUF model.
LLAMA_BIN_PATH=C:/dev/llama.cpp/llama-server.exe
LLAMA_MODEL_PATH=C:/dev/llama.cpp/models/poby_r8_q5km.gguf
LLM_MAX_TOKENS=80
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_REPEAT_PENALTY=1.1
LLM_THREADS=4
LLM_CONTEXT_SIZE=1024

# TTS: MeloTTS KR ONNX model.
TTS_MODEL_PATH=C:/path/to/OFFLINE_VOICE/backend/models/tts/melotts/melotts_base_kr_v2.onnx
TTS_CONFIG_PATH=unused
MELOTTS_REPO_PATH=C:/path/to/OFFLINE_VOICE/backend/vendor/MeloTTS-Windows

# Microphone recording/VAD.
AUDIO_RECORD_FILE=C:/dev/recorded.wav
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=512
AUDIO_VAD_THRESHOLD=0.8
AUDIO_SILENCE_SEC=2.5
AUDIO_MAX_SEC=30.0

# Runtime DB. Omit to use backend/airi.db.
DB_PATH=
